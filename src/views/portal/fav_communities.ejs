<%- include('partials/header') %>
<% const t = lang["olv.portal"]; %>

<div id="body">
    <header id="header">
        <h1 id="page-title" class="left"><%= t.favorites_communities %></h1>
    </header>

    <div class="body-content" id="community-top">
        <div class="community-list">
            <% if (communities.length) { %>
                <ul class="list-content-with-icon-column">
                    <%- include('partials/community') %>
                </ul>
            <% } else { %>
                <div class="no-content-window">
                    <div class="window">
                        <p><%= t.no_favorites %></p>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>
