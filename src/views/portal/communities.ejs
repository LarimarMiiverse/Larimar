<%- include('partials/header') %>
<% const t = lang["olv.portal"]; %>
<% const heading = query !== null ? t.search_results : (category ? t['category_' + category] : t.all_communities); %>

<div id="body">
    <header id="header">
        <a id="header-favorites-button" href="/communities/favorites" data-pjax="#body"><%= t.favorites_communities %></a>
        <h1 id="page-title" class="left"><%= t.community %></h1>
    </header>

    <div id="community-top" class="body-content">
        <div class="community-list">
            <span type="button" class="fixed-bottom-button search-button" id="community-search"><%= t.search %>
                <input name="query" class="title-search-query" minlength="2" maxlength="20" inputform="monospace" guidestring="<%= t.search_titles %>" data-pjax="#body">
            </span>

            <div class="headline with-filter">
                <h2><%= heading %></h2>
                <div class="with-filter-right">
                    <div class="dropdown">
                        <a class="dropdown-toggle" data-toggle="dropdown" data-sound="SE_WAVE_BALLOON_OPEN" href="#"><%= t.filter %></a>
                        <ul class="dropdown-menu">
                            <li><a class="button" href="/communities" data-pjax="#body"><%= t.all_communities %></a></li>
                            <% categories.forEach(function (c) { %>
                                <li><a class="button" href="/communities/categories/<%= c %>" data-pjax="#body"><%= t['category_' + c] %></a></li>
                            <% }); %>
                        </ul>
                    </div>
                </div>
            </div>

            <% if (communities.length) { %>
                <ul class="list-content-with-icon-column" id="community-top-content">
                    <%- include('partials/community') %>
                </ul>
            <% } else { %>
                <div class="no-content-window">
                    <div class="window">
                        <p><%= query !== null ? t.no_search_results : t.no_communities %></p>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>
