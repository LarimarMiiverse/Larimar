<%- include('partials/header') %>

<div id="body">
    <header id="header">
        <h1 id="page-title" class="left">Error</h1>
    </header>

    <div class="body-content track-error" data-track-error="<%= code %>">
        <div class="no-content-window">
            <div class="window">
                <p><%= message || "An error occurred" %></p>
            </div>
        </div>
    </div>
</div>